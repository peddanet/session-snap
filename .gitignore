# Real user data never belongs into this repository.
# session-snap keeps it in ~/scripts/session-snap.d/ (snapshots, logs, backups, config).
session-snap.d/
session-snap_*.json
!examples/demo-snapshot.json
*.log
config.ini
programs.ini
order.json

# Generated by examples/make_demo_media.py
examples/demo-media/

# Documentation build output (PDFs are attached to GitHub releases)
*.pdf
build/

# Python / tool caches
__pycache__/
*.py[cod]
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.check/
.venv-check/

# Editors
*~
*.swp
.vscode/
.idea/
.privacy-patterns
